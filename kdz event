import 'package:flutter/material.dart';

void main() {
  runApp(KdzEventApp());
}

class KdzEventApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'kdz.event',
      theme: ThemeData(primarySwatch: Colors.deepPurple),
      home: EventListPage(),
    );
  }
}

class EventListPage extends StatefulWidget {
  @override
  _EventListPageState createState() => _EventListPageState();
}

class _EventListPageState extends State<EventListPage> {
  final List<Map<String, dynamic>> events = [
    {'name': 'Concert de Kinshasa', 'price': '1000 FCFA'},
    {'name': 'Soirée Afrobeat', 'price': '2000 FCFA'},
    {'name': 'Festival Urbain', 'price': '1500 FCFA'},
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Événements disponibles')),
      body: ListView.builder(
        itemCount: events.length,
        itemBuilder: (context, index) {
          final event = events[index];
          return ListTile(
            title: Text(event['name']),
            subtitle: Text('Prix du ticket : ${event['price']}'),
            trailing: Icon(Icons.arrow_forward_ios),
            onTap: () {
              Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (context) => TicketPage(event: event),
                ),
              );
            },
          );
        },
      ),
    );
  }
}

class TicketPage extends StatelessWidget {
  final Map<String, dynamic> event;

  TicketPage({required this.event});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(event['name'])),
      body: Padding(
        padding: const EdgeInsets.all(20.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.center,
          children: [
            SizedBox(height: 40),
            Icon(Icons.confirmation_num_outlined, size: 80),
            SizedBox(height: 20),
            Text(
              'Ticket pour : ${event['name']}',
              style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
              textAlign: TextAlign.center,
            ),
            SizedBox(height: 20),
            Text('Prix : ${event['price']}', style: TextStyle(fontSize: 18)),
            Spacer(),
            ElevatedButton(
              onPressed: () {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(content: Text('Ticket réservé avec succès !')),
                );
              },
              child: Text('Réserver'),
              style: ElevatedButton.styleFrom(
                padding: EdgeInsets.symmetric(horizontal: 40, vertical: 15),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
